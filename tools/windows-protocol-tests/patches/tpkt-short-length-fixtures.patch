+    /// <summary>
+    /// Wrapper that sets TPKT length below the serialized slow-path PDU length.
+    /// </summary>
+    public class SlowPathOutputPduWithInvalidTpktLength : SlowPathOutputPdu
+    {
+        public SlowPathOutputPduWithInvalidTpktLength(SlowPathOutputPdu original, RdpbcgrServerSessionContext context)
+            : base(context)
+        {
+            this.commonHeader = original.commonHeader;
+            this.slowPathUpdates = original.slowPathUpdates;
+        }
+
+        public override byte[] ToBytes()
+        {
+            // The zero header field means automatic length, not a zero-byte PDU.
+            // Serialize once to avoid advancing an encrypted session twice.
+            byte[] bytes = base.ToBytes();
+            ushort invalidLength = checked((ushort)(bytes.Length - 1));
+            bytes[2] = (byte)(invalidLength >> 8);
+            bytes[3] = (byte)invalidLength;
